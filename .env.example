APIFY_API_TOKEN=your_apify_token
OPENROUTER_API_KEY=your_openrouter_key
# Caption extract / JSON (multimodal text). No google/gemini-3.1-flash slug — use lite.
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
# Slideshow image gen only (Nano Banana 2). Never use for OCR.
GEMINI_MODEL=google/gemini-3.1-flash-image
POSTIZ_API_KEY=your_postiz_api_key
POSTIZ_TIKTOK_INTEGRATION_ID=your_tiktok_integration_id

# Visual OCR (cover/slideshow on-screen text). Chain: Tesseract → OCR_MODEL → fallbacks.
# Do not use google/gemini-2.0-flash-001 (gone) or *-flash-image* (image-gen only).
OCR_MODEL=google/gemini-3.1-flash-lite
OCR_FALLBACK_MODELS=google/gemini-3-flash-preview
OCR_USE_TESSERACT=true
OCR_TESSERACT_LANG=eng+kor

# RevenueCat V2 (optional — analytics works without it, Postiz-only mode)
# Create a V2 API key in RevenueCat dashboard with permissions:
#   charts_metrics:overview:read, customer_information:subscriptions:read
REVENUECAT_V2_SECRET_KEY=
REVENUECAT_PROJECT_ID=
